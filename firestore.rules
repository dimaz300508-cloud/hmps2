rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidCommunitySubmission(data) {
      return data.keys().hasAll([
          'nameMode',
          'name',
          'pollOptionId',
          'pollOption',
          'rating',
          'criticism',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'nameMode',
          'name',
          'pollOptionId',
          'pollOption',
          'rating',
          'criticism',
          'createdAt'
        ])
        && data.nameMode in ['anonymous', 'named']
        && data.name is string
        && data.name.size() <= 80
        && (data.nameMode == 'anonymous' ? data.name == 'Anonim' : data.name.size() > 0)
        && data.pollOptionId is string
        && data.pollOptionId.matches('^(1|2|3|4|custom-[A-Za-z0-9-]{1,80})$')
        && data.pollOption is string
        && data.pollOption.size() > 0
        && data.pollOption.size() <= 160
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.criticism is string
        && data.criticism.size() > 0
        && data.criticism.size() <= 2000
        && data.createdAt == request.time;
    }

    match /siteContent/{documentId} {
      allow read: if documentId == 'public';
      allow create, update, delete: if documentId == 'public' && isAdmin();
    }

    match /communitySubmissions/{submissionId} {
      allow read, delete: if isAdmin();
      allow create: if isValidCommunitySubmission(request.resource.data);
      allow update: if false;
    }

    match /communityRateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
